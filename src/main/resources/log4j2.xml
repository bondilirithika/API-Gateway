<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Property>
        <Property name="APP_LOG_ROOT">logs</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- Application Log File Appender -->
        <RollingFile name="AppFileAppender"
                     fileName="${APP_LOG_ROOT}/app.log"
                     filePattern="${APP_LOG_ROOT}/app-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Standard Log File Appender -->
        <RollingFile name="StandardFileAppender"
                     fileName="${APP_LOG_ROOT}/application.log"
                     filePattern="${APP_LOG_ROOT}/application-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Root Logger -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="StandardFileAppender"/>
        </Root>

        <!-- Application Logger - Only specific packages -->
        <Logger name="com.example.demo.TestController" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFileAppender"/>
            <AppenderRef ref="StandardFileAppender"/>
        </Logger>

        <!-- Zenv Logging Logger -->
        <Logger name="com.zenv" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFileAppender"/>
            <AppenderRef ref="StandardFileAppender"/>
        </Logger>

        <!-- Filter out Spring Boot startup logs from app.log -->
        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="StandardFileAppender"/>
        </Logger>

        <!-- Filter out Spring Boot application logs from app.log -->
        <Logger name="com.example.demo.DemoApplication" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="StandardFileAppender"/>
        </Logger>
    </Loggers>
</Configuration> 